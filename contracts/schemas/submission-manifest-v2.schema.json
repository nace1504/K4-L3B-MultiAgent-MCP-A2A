{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://day09.vinaction.local/contracts/submission-manifest-v2.schema.json",
  "title": "Day09 submission manifest V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "competition_id",
    "variant_id",
    "case_set_version",
    "output_schema_version",
    "trace_schema_version",
    "generated_at"
  ],
  "properties": {
    "schema_version": {"const": "day09-submission-manifest-v2"},
    "competition_id": {"const": "day09-multiagent-mcp-a2a"},
    "variant_id": {"enum": ["l3a", "l3b"]},
    "case_set_version": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "output_schema_version": {
      "enum": ["day09-l3a-output-v2", "day09-l3b-output-v2"]
    },
    "trace_schema_version": {"const": "day09-trace-event-v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "client": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "version": {"type": "string", "minLength": 1, "maxLength": 40}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"variant_id": {"const": "l3a"}}},
      "then": {"properties": {"output_schema_version": {"const": "day09-l3a-output-v2"}}}
    },
    {
      "if": {"properties": {"variant_id": {"const": "l3b"}}},
      "then": {"properties": {"output_schema_version": {"const": "day09-l3b-output-v2"}}}
    }
  ]
}
